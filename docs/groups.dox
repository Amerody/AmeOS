DRIVERS

/**
 * @defgroup drivers Drivers
 * @brief Hardware drivers for the BCM2711 peripherals.
 */

/**
 * @defgroup mmio MMIO Driver
 * @ingroup drivers
 * @brief Memory Mapped I/O read/write operations
 */

/**
 * @defgroup gpio GPIO Driver
 * @ingroup drivers
 * @brief Pin function select, set/clear, pull configuration.
 */

/**
 * @defgroup uart UART Driver
 * @ingroup drivers
 * @brief Public API for UART0-5 (UART1 is the mini UART).
 *
 * See decision 0004 (docs/internal/decisions/0004-uart-layout.md) for the module layout.
 */

/**
 * @defgroup aux AUX Peripherals
 * @ingroup drivers
 * @brief Shared AUX block (enables and IRQ status) used by the mini UART and SPI1/2.
 */

/**
 * @defgroup timer Timer Driver
 * @ingroup drivers
 * @brief ARMv8-A timer Driver
 */

/**
 * @defgroup gic GIC-400 Driver
 * @ingroup drivers
 * @brief GICv2 (GIC-400) interrupt controller, and the hal_irq implementation on top of it.
 */

/**
 * @defgroup mailbox Mailbox Driver
 * @ingroup drivers
 * @brief VideoCore mailbox: property-tag requests to the firmware.
 */

/**
 * @defgroup framebuffer Framebuffer Driver
 * @ingroup drivers
 * @brief hal_fb implementation: a framebuffer allocated through the mailbox, and pixel drawing.
 */



KERNEL

/**
 * @defgroup kernel Kernel
 * @brief Kernel functions.
 */

/**
 * @defgroup console Kernel Console
 * @ingroup kernel
 * @brief Kernel console
 */

/**
 * @defgroup print Kernel Print Utilities
 * @ingroup kernel
 * @brief Kernel Print Utilities
 */

/**
 * @defgroup shell Kernel Shell
 * @ingroup kernel
 * @brief Line-editing shell on the console and its built-in commands.
 */


LIB

/**
 * @defgroup lib Kernel Library
 * @brief Freestanding helpers with no hardware access: string and memory functions
 *        (the kernel has no libc) and generic data structures.
 */



GFX

/**
 * @defgroup gfx Graphics Library
 * @brief Colours and the bitmap font, drawn through hal_fb. No hardware access of its own.
 */



ARCH

/**
 * @defgroup arch CPU Architecture
 * @brief CPU-architecture layer (include/arch, src/arch/\<ARCH\>): boot, exception
 *        vectors and handlers, CPU interrupt masking, saved execution state.
 */
