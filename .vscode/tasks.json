{
  // Works on Windows (PowerShell, the VS Code default) and Linux/macOS (bash/zsh).
  // Requires qemu-system-aarch64 on PATH. On Windows the installer's folder
  // (C:\Program Files\qemu) must be added to PATH, as in the install steps.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-kernel",
      "type": "shell",
      "command": "cmake --build --preset ${command:cmake.activeBuildPresetName} --target kernel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "qemu-debug",
      "type": "shell",
      "dependsOn": "build-kernel",
      "isBackground": true,
      "command": "cmake --build --preset ${command:cmake.activeBuildPresetName} --target debug",
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "QEMU_BEGIN",
          "endsPattern": "QEMU_READY"
        }
      },
      "group": "build"
    },
    {
      "label": "qemu-stop",
      "type": "shell",
      "command": "echo ${input:terminateQemu}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    { "id": "terminateQemu", "type": "command",
      "command": "workbench.action.tasks.terminate", "args": "qemu-debug" }
  ]
}
