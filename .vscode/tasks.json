{
  // Works on Windows (PowerShell, the VS Code default) and Linux/macOS (bash/zsh).
  // QEMU is started through the CMake "debug" target, so it is found the same way
  // as for the build (PATH, or C:\Program Files\qemu on Windows).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-kernel",
      "type": "shell",
      "command": "cmake --build --preset ${command:cmake.activeBuildPresetName} --target kernel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "qemu-debug",
      "type": "shell",
      "dependsOn": "build-kernel",
      "isBackground": true,
      "command": "cmake --build --preset ${command:cmake.activeBuildPresetName} --target debug",
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        // Ready once the CMake "debug" target prints its COMMENT, right before QEMU starts.
        // activeOnStart makes the task "busy" immediately; beginsPattern is never printed.
        "background": {
          "activeOnStart": true,
          "beginsPattern": "QEMU_BEGIN",
          "endsPattern": "waiting for GDB"
        }
      },
      "group": "build"
    },
    {
      "label": "qemu-stop",
      "type": "shell",
      "command": "echo ${input:terminateQemu}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    { "id": "terminateQemu", "type": "command",
      "command": "workbench.action.tasks.terminate", "args": "qemu-debug" }
  ]
}
