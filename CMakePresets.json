{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
        "name": "base",
        "hidden": true,
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/${presetName}",
        "toolchainFile": "${sourceDir}/cmake/toolchain-aarch64.cmake",
        "cacheVariables": {
            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
        }
    },
    {
        "name": "debug",
        "hidden": true,
        "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug",
            "KERNEL_DOCS_INTERNAL": "ON"
        }
    },
    {
        "name": "release",
        "hidden": true,
        "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Release",
            "KERNEL_DOCS_INTERNAL": "OFF"
        }
    },
    {
        "name": "rpi4-debug",
        "displayName": "Raspberry Pi 4 | Debug",
        "inherits": ["base", "debug"]
    },
    {
        "name": "rpi4-release",
        "displayName": "Raspberry Pi 4 | Release",
        "inherits": ["base", "release"]
    }
  ],
  "buildPresets": [
    {
        "name": "rpi4-debug",
        "configurePreset": "rpi4-debug"
    },
    {
        "name": "rpi4-release",
        "configurePreset": "rpi4-release"
    }
  ]
}